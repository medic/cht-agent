# ─────────────────────────────────────────────────────────────────────────
# LLM provider resolution for the seeding pipeline (filter + distiller)
# Order of precedence:
#   1. LLM_PROVIDER=claude-cli  -> runs `claude -p` on the operator's Claude
#      subscription; no API key. TRIAGE_MODEL/DISTILL_MODEL do not apply —
#      the model/effort come from ANTHROPIC_MODEL + CLAUDE_CODE_EFFORT_LEVEL.
#   2. OPENROUTER_API_KEY set   -> OpenRouter API with the models below.
#   3. ANTHROPIC_API_KEY set    -> Anthropic API fallback.
# Recommended for seeding: claude-cli on Opus 4.8 at max effort.
LLM_PROVIDER=claude-cli
# ─────────────────────────────────────────────────────────────────────────

# Claude Code CLI mode (LLM_PROVIDER=claude-cli) — model + effort are read by
# the `claude` binary from these env vars (no API key needed).
ANTHROPIC_MODEL=claude-opus-4-8
CLAUDE_CODE_EFFORT_LEVEL=max

# PRs processed concurrently by run-pipeline (default --concurrency). Clamped to
# [1, 10]; 3-5 is the sweet spot. At 4 with Opus 4.8/max, give the container
# headroom (SEEDER_MEMORY_LIMIT) — each PR spawns its own `claude` process.
PIPELINE_CONCURRENCY=4

# Claude Code CLI configuration (only used when LLM_PROVIDER=claude-cli)
# CLAUDE_CLI_PATH=claude
# CLAUDE_CLI_TIMEOUT=300000
# CLAUDE_CLI_MAX_TURNS=1
# CLAUDE_CLI_SKIP_PERMISSIONS=true

# Research flow (npm run research) honors LLM_PROVIDER=claude-cli too: the
# orchestration planner and domain inference run via `claude -p` with no
# ANTHROPIC_API_KEY. Model/effort come from ANTHROPIC_MODEL +
# CLAUDE_CODE_EFFORT_LEVEL above (read by the claude binary itself).
# When LLM_PROVIDER is unset, the research flow uses the Anthropic API
# (ANTHROPIC_API_KEY required; default model claude-sonnet-4-20250514).
# OPENROUTER_API_KEY does not apply to the research flow.

# ── API path (only used when LLM_PROVIDER is unset) ──────────────────────
# Anthropic API key
ANTHROPIC_API_KEY=your_api_key_here

# OpenRouter API key (used when OPENROUTER_API_KEY is set; takes priority over Anthropic)
OPENROUTER_API_KEY=your_openrouter_key_here

# Model for PR triage/filter step (ignored in claude-cli mode)
TRIAGE_MODEL=anthropic/claude-opus-4-8

# Model for PR distillation step (ignored in claude-cli mode)
DISTILL_MODEL=anthropic/claude-opus-4-8

# Kapa AI documentation MCP server (optional override)
# MCP_SERVER_URL=https://mcp-docs.dev.medicmobile.org/mcp

# OpenDeepWiki code context MCP server (optional override)
# Repo-specific query parameters (?owner=medic&name=<repo>) are appended per request
# DEEPWIKI_MCP_URL=https://opendeepwiki.dev.medicmobile.org/api/mcp
# DEEPWIKI_MCP_TIMEOUT=30000

# Test Environment Layer: URL of the operator-provisioned CHT instance.
# provision() fallback order: options.url ?? CHT_URL ?? https://nginx
# CHT_URL=https://nginx

# Test Environment Layer: credentials for the provisioned instance (same seam
# scripts/test-env-up.sh uses). Fallback order in provision():
# options.auth ?? creds embedded in CHT_URL (stripped from logged URLs) ??
# COUCHDB_USER/COUCHDB_PASSWORD ?? medic/password
# COUCHDB_USER=medic
# COUCHDB_PASSWORD=password

# The default env (https://nginx) serves a self-signed cert. cht-conf handles
# its own via --accept-self-signed-certs (which sets the var below inside that
# process); the agent's OWN fetch paths (readiness poll, discoverConfig,
# couchdb reset) need the operator to export it for the agent process — or
# provide the CA via NODE_EXTRA_CA_CERTS instead.
# NODE_TLS_REJECT_UNAUTHORIZED=0
