{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/medic/cht-agent/agent-memory/schema.json",
  "title": "CHT Agent Context File Schema",
  "description": "Schema for validating context files in agent-memory",
  "type": "object",
  "definitions": {
    "CHTDomain": {
      "type": "string",
      "enum": [
        "authentication",
        "contacts",
        "forms-and-reports",
        "tasks-and-targets",
        "messaging",
        "data-sync",
        "configuration",
        "interoperability",
        "infrastructure",
        "data-access"
      ],
      "description": "One of the functional domains in CHT"
    },
    "CHTCategory": {
      "type": "string",
      "enum": ["bug", "feature", "improvement"],
      "description": "Issue category"
    },
    "CHTWorkflow": {
      "type": "string",
      "enum": [
        "form-submission",
        "user-registration",
        "contact-creation",
        "task-scheduling",
        "message-processing",
        "data-migration",
        "ui-extensions",
        "nouveau-search",
        "observability"
      ],
      "description": "Cross-domain workflow processes and technical workstreams"
    },
    "CHTService": {
      "type": "string",
      "enum": ["api", "webapp", "sentinel", "admin"],
      "description": "CHT services"
    },
    "CHTConfidence": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "Distillation confidence: high=human-reviewed, medium=unreviewed draft with grounded relatedFiles, low=unreviewed draft that is a backport/fallback, has ungrounded relatedFiles, or is stale"
    },
    "frontmatter": {
      "type": "object",
      "description": "YAML frontmatter for markdown context files",
      "required": ["id", "category", "domain", "issueNumber", "issueUrl", "title", "lastUpdated", "summary", "services", "techStack"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cht-(core|interoperability)-[1-9][0-9]*$",
          "description": "Identifier, format: cht-(core|interoperability)-<issue-number>. Not globally unique — several PRs can resolve one issue, so consumers dedup on issueNumber (see #135)."
        },
        "category": {
          "$ref": "#/definitions/CHTCategory"
        },
        "domain": {
          "$ref": "#/definitions/CHTDomain"
        },
        "domainFit": {
          "type": "string",
          "enum": ["strong", "weak"],
          "description": "Whether the chosen domain is a principled match (strong) or a forced least-bad pick (weak)"
        },
        "secondaryDomains": {
          "type": "array",
          "items": { "$ref": "#/definitions/CHTDomain" },
          "uniqueItems": true,
          "minItems": 1,
          "description": "Additional domains this memory is also relevant to, ranked below the primary `domain`. To be human-set on the cht-datasource cluster (annotations pending); not auto-emitted by the distiller. Must not include the primary `domain` itself — draft-07 cannot express that, so validate-schema enforces it. NB retrieval selects candidates by primary-domain directory (see #135), so a secondary domain does not surface a memory until candidate selection reads this field."
        },
        "subDomain": {
          "type": "string",
          "description": "More specific area within the domain"
        },
        "issueNumber": {
          "type": "integer",
          "minimum": 1,
          "description": "The source GitHub issue number"
        },
        "issueUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/medic/(cht-core|cht-interoperability)/issues/[1-9][0-9]*$",
          "description": "Full URL to the source issue"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Brief descriptive title"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date",
          "description": "Date of last update (YYYY-MM-DD)"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "1-2 sentence overview of the issue and resolution"
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CHTService"
          },
          "minItems": 1,
          "description": "Which CHT services are involved"
        },
        "techStack": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Technologies relevant to the fix"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 50 },
          "description": "Optional freeform tags for searchability"
        },
        "related_workflows": {
          "type": "array",
          "items": { "$ref": "#/definitions/CHTWorkflow" },
          "description": "Related cross-domain workflows"
        },
        "related_services": {
          "type": "array",
          "items": { "$ref": "#/definitions/CHTService" },
          "description": "Related CHT services"
        },
        "source_pr": {
          "type": "string",
          "pattern": "^medic/(cht-core|cht-interoperability)#[1-9][0-9]*$",
          "description": "Source PR reference, format: medic/<repo>#<number>"
        },
        "source_prs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^medic/(cht-core|cht-interoperability)#[1-9][0-9]*$"
          },
          "minItems": 1,
          "description": "All PR refs that resolve to this issue (backport cherry-picks, multi-PR epics), set by the dedup pass when more than one draft collapsed into this one. source_pr remains the canonical PR."
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "Commit SHA of the PR at the time of distillation"
        },
        "distilled_at": {
          "type": "string",
          "format": "date",
          "description": "ISO date when this entry was machine-distilled (YYYY-MM-DD)"
        },
        "reviewed_by": {
          "type": ["string", "null"],
          "description": "GitHub handle of the human reviewer, or null if unreviewed"
        },
        "reviewed_at": {
          "type": ["string", "null"],
          "format": "date",
          "description": "ISO date when the entry was reviewed, or null if unreviewed"
        },
        "confidence": {
          "$ref": "#/definitions/CHTConfidence"
        },
        "entities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Referenced files, modules, or named patterns"
        },
        "concepts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Referenced architectural or domain concepts"
        },
        "related_issues": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Candidate related agent-memory entry ids (cht-core-<n>), derived from this PR's own secondary linked issues; not verified to have a promoted memory entry"
        },
        "stale": {
          "type": "boolean",
          "description": "Set to true by the freshness process when source files have changed significantly"
        }
      }
    },
    "domainToComponentsIndex": {
      "type": "object",
      "description": "Maps domains to their component files",
      "properties": {
        "last_updated": {
          "type": "string",
          "format": "date-time"
        },
        "domains": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "api": {
                "type": "object",
                "properties": {
                  "controllers": { "type": "array", "items": { "type": "string" } },
                  "services": { "type": "array", "items": { "type": "string" } }
                }
              },
              "webapp": {
                "type": "object",
                "properties": {
                  "modules": { "type": "array", "items": { "type": "string" } },
                  "services": { "type": "array", "items": { "type": "string" } }
                }
              },
              "sentinel": {
                "type": "object",
                "properties": {
                  "transitions": { "type": "array", "items": { "type": "string" } }
                }
              },
              "shared_libs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "path": { "type": "string" },
                    "critical": { "type": "boolean" }
                  }
                }
              },
              "tests": {
                "type": "object",
                "properties": {
                  "unit": { "type": "array", "items": { "type": "string" } },
                  "integration": { "type": "array", "items": { "type": "string" } },
                  "e2e": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "errorPatternsIndex": {
      "type": "object",
      "description": "Maps error patterns to locations and solutions",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "common_locations": {
            "type": "array",
            "items": { "type": "string" }
          },
          "related_domains": {
            "type": "array",
            "items": { "$ref": "#/definitions/CHTDomain" }
          },
          "typical_causes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "solutions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "test_scenarios": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
